doctype html
html
  head
    title Users
    style.
      body {
        font-family: Arial, sans-serif;
        background: #f2f2f2;
      }
      .container {
        width: 80%;
        margin: auto;
      }
      .card {
        display: flex;
        align-items: center;
        background: white;
        padding: 15px;
        margin: 10px 0;
        border-radius: 6px;
        box-shadow: 0 0 5px rgba(0,0,0,0.1);
      }
      img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border-radius: 6px;
        margin-right: 20px;
      }
  body
    .container
      h1 Registered Users

      each user in users
        .card
          img(src=user.image, alt="User Image")
          div
            p
              strong Username:
              |  #{user.user}
